# Domain Configuration
APP_DOMAIN=seu-dominio-aqui.com
API_DOMAIN=api.seu-dominio-aqui.com

# Meta Credentials (WhatsApp Business API)
META_APP_ID=seu_app_id
META_APP_SECRET=seu_app_secret
META_BUSINESS_ACCOUNT_ID=seu_business_account_id
META_PHONE_NUMBER_ID=seu_phone_number_id
META_WEBHOOK_TOKEN=gere_um_token_aleatorio_forte

# Database Configuration
DATABASE_URL=postgresql://usuario:senha@postgres:5432/campanhas_db
DB_USER=usuario
DB_PASSWORD=gere_uma_senha_forte

# Redis Configuration
REDIS_URL=redis://redis:6379

# Application
NODE_ENV=production
APP_PORT=3000
API_PORT=5000

# Security
JWT_SECRET=gere_um_jwt_secret_aleatorio_forte

# Optional: S3/R2 Storage (para arquivos reais)
# STORAGE_TYPE=s3
# S3_BUCKET=seu-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY=sua_access_key
# S3_SECRET_KEY=sua_secret_key
